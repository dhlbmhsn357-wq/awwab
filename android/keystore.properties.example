# انسخ الملف ده لـ keystore.properties (بدون .example) في نفس
# المجلد ده (android/) وعبّي القيم الحقيقية بعد ما تعمل keytool —
# راجع RELEASE.md للخطوات كاملة. الملف ده (من غير .example) اتضاف
# لـ.gitignore أصلًا — أبدًا متسجّلوش في Git.

storeFile=../awwab-release.keystore
storePassword=CHANGE_ME
keyAlias=awwab
keyPassword=CHANGE_ME
