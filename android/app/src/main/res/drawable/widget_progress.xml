<?xml version="1.0" encoding="utf-8"?>
<!-- شريط تقدّم رفيع بحواف دائرية — RemoteViews-safe (layer-list عادي).
     الألوان تُحل تلقائيًا حسب الوضع (فاتح/داكن) عبر @color؛ لذلك لا
     نستخدم progressTint في التخطيط ونترك التلوين للـdrawable. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="@color/widget_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <solid android:color="@color/widget_fill" />
            </shape>
        </clip>
    </item>
</layer-list>
